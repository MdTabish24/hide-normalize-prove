# LOCAL PLACEHOLDERS ONLY. Run python init_env.py to generate distinct demo secrets.
RED_TOKEN=replace-with-a-random-red-token
BLUE_TOKEN=replace-with-a-random-blue-token
EVALUATOR_TOKEN=replace-with-a-random-evaluator-token
GATEWAY_KEY=replace-with-64-random-hex-characters
BLUE_SERVICE_TOKEN=replace-with-a-random-internal-token
MODEL_SERVICE_TOKEN=replace-with-a-different-internal-token
AUDIT_TOKEN=replace-with-a-separate-local-audit-token
BUCKETS=3,6,9
HIT_SECONDS=0.3
MISS_SECONDS=2.0
JITTER_SECONDS=0.02
# Safe defaults. Enable the delay hook ONLY on isolated evaluation servers.
POLICY_MODE=window_hard
WINDOW_CONTINUE=1
AUDIT_BATCH=50
RANGE_SEED_MODE=run
EVAL_MODE=0
# Optional REAL provider overlay only. Set the key in the launching process,
# never commit a real key. The default Docker stack remains offline/mock.
DEEPSEEK_MODEL=deepseek-flash
MAX_OUTPUT_TOKENS=128
PROVIDER_TIMEOUT_SECONDS=6
